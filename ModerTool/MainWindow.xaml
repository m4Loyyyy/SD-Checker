                    <!-- ACCOUNTS -->
                    <Grid x:Name="PageAccounts" Visibility="Collapsed">
                        <DataGrid x:Name="SteamAccountsGrid" Background="Transparent" Foreground="White" HeadersVisibility="Column" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1" BorderBrush="#FF2A2A2A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF2A2A2A" RowBackground="Transparent">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FF1A1A1A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5,10"/>
                                    <Setter Property="BorderBrush" Value="#FF2A2A2A"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VAC}" Value="VAC BANNED">
                                            <Setter Property="Background" Value="#FF4D0000"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VAC}" Value="GAME BANNED">
                                            <Setter Property="Background" Value="#FF4D0000"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColSteamID" Header="Steam64ID" Binding="{Binding Steam64ID}" Width="2*"/>
                                <DataGridTextColumn x:Name="ColName" Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn x:Name="ColLevel" Header="Level" Binding="{Binding Level}" Width="1*"/>
                                <DataGridTextColumn x:Name="ColVAC" Header="VAC" Binding="{Binding VAC}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
                            <Button Click="BtnScanSteam_Click" Style="{StaticResource GhostBtn}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4.93 4.93C2.86 7 1.5 9.84 1.5 13c0 3.16 1.36 6 3.43 8.07l1.41-1.41C4.56 17.88 3.5 15.59 3.5 13s1.06-4.88 2.84-6.66L4.93 4.93zm13.14 0l-1.41 1.41C18.44 8.12 19.5 10.41 19.5 13s-1.06 4.88-2.84 6.66l1.41 1.41C20.14 19 21.5 16.16 21.5 13c0-3.16-1.36-6-3.43-8.07zM7.76 7.76C6.38 9.14 5.5 10.97 5.5 13c0 2.03.88 3.86 2.26 5.24l1.41-1.41C8.18 15.84 7.5 14.51 7.5 13c0-1.51.68-2.84 1.67-3.83L7.76 7.76zm8.48 0l-1.41 1.41C15.82 10.16 16.5 11.49 16.5 13c0 1.51-.68 2.84-1.67 3.83l1.41 1.41C17.62 15.86 18.5 14.03 18.5 13c0-2.03-.88-3.86-2.26-5.24zM12 10.5c-1.38 0-2.5 1.12-2.5 2.5s1.12 2.5 2.5 2.5 2.5-1.12 2.5-2.5-1.12-2.5-2.5-2.5z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAccScan" Text="Сканировать Steam" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnExportSteam_Click" Style="{StaticResource GhostBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAccExport" Text="Выгрузить SteamID" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- LOGS -->
                    <Grid x:Name="PageLogs" Visibility="Collapsed">
                        <Border Background="#FF2A2A2A" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="White">
                                    <TextBlock x:Name="TxtLogsTitle" Text="Logs" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Consolas"/>
                                </Border>
                                <TextBox Grid.Row="1" x:Name="TxtLogs" IsReadOnly="True" Background="Transparent" Foreground="White" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="10"/>
                            </Grid>
                        </Border>
                    </Grid>

